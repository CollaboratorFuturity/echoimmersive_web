{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "deck-stage.js",
              "image-slot.js"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Montserrat|Roboto))/i]",
        "message": "Font not provided by the design system. Available: Montserrat, Roboto."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
      "--accent",
      "--accent-bar-h",
      "--accent-bar-w",
      "--accent-deep",
      "--bullet-dash-h",
      "--bullet-dash-w",
      "--cover-strip-bottom",
      "--echo-cream",
      "--echo-footer-num",
      "--echo-ink",
      "--echo-ink-deep",
      "--echo-land",
      "--echo-land-active",
      "--echo-purple",
      "--echo-purple-deep",
      "--echo-rule",
      "--echo-rule-soft",
      "--echo-text-body",
      "--echo-text-dim",
      "--echo-text-faint",
      "--echo-text-muted",
      "--echo-text-strong",
      "--eu-emblem-h",
      "--font-body",
      "--font-display",
      "--footer-inset",
      "--fw-black",
      "--fw-bold",
      "--fw-light",
      "--fw-medium",
      "--fw-regular",
      "--fw-semibold",
      "--gap-bullet",
      "--gap-head-lead",
      "--gap-kicker-head",
      "--headline-leading",
      "--headline-tracking",
      "--kicker-tracking",
      "--kicker-transform",
      "--logo-cover-w",
      "--logo-footer-h",
      "--radius-image",
      "--slide-pad-bottom",
      "--slide-pad-top",
      "--slide-pad-x",
      "--surface-page",
      "--surface-well",
      "--t-body",
      "--t-caption",
      "--t-detail",
      "--t-display",
      "--t-footer",
      "--t-h2",
      "--t-hero",
      "--t-kicker",
      "--t-lead",
      "--text-on-dark"
    ],
    "tokenKinds": {
      "--echo-ink": "color",
      "--echo-ink-deep": "color",
      "--echo-purple": "color",
      "--echo-purple-deep": "color",
      "--echo-cream": "color",
      "--echo-text-strong": "font",
